generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AccessToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  label     String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ShellEvent {
  id           String   @id @default(cuid())
  kind         String
  createdAt    DateTime @default(now())
  metadataJson String?
}

model Task {
  id               String        @id @default(cuid())
  title            String
  description      String?
  status           String        @default("inbox")
  importance       String        @default("normal")
  isUrgent         Boolean       @default(false)
  dueDate          DateTime?
  doDate           DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  sourceLabel      String?
  personLabel      String?
  waitingDirection String?
  responseDueDate  DateTime?
  waitingSince     DateTime?
  reminderAt       DateTime?
  reminderSentAt   DateTime?
  completedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  contexts TaskContext[]
  notes    TaskNote[]
  focusSelections DailyFocusSelection[]
  calendarLink TaskCalendarLink?

  @@index([status, archivedAt])
  @@index([doDate])
  @@index([dueDate])
  @@index([reminderAt])
  @@index([waitingDirection])
  @@index([responseDueDate])
  @@index([categoryId])
  @@index([projectId])
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  color         String
  systemDefault Boolean   @default(false)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tasks Task[]
}

model Context {
  id            String    @id @default(cuid())
  name          String    @unique
  systemDefault Boolean   @default(false)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tasks TaskContext[]
}

model TaskContext {
  taskId    String
  contextId String
  createdAt DateTime @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  context Context @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@id([taskId, contextId])
  @@index([contextId])
}

model Project {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]
}

model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model CalendarFeedToken {
  id        String   @id @default(cuid())
  token     String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskCalendarLink {
  id                 String   @id @default(cuid())
  taskId             String   @unique
  eventUid           String   @unique
  allDay             Boolean  @default(true)
  startsAt           DateTime
  endsAt             DateTime?
  includeDescription Boolean  @default(true)
  includeNotes       Boolean  @default(false)
  sequence           Int      @default(0)
  lastSyncedAt       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([startsAt])
}

model PushSubscription {
  id        String    @id @default(cuid())
  endpoint  String    @unique
  p256dh    String
  auth      String
  label     String?
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastSeenAt DateTime @default(now())
}

model NotificationPreference {
  key       String   @id
  enabled   Boolean  @default(false)
  time      String?
  updatedAt DateTime @updatedAt
}

model DailyFocusSelection {
  id          String   @id @default(cuid())
  focusDate   DateTime
  slot        Int
  taskId      String
  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([focusDate, slot])
  @@unique([focusDate, taskId])
  @@index([taskId])
}
